[Unit]
Description=WARP Egress Gateway persistent kill switch and NAT
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target warp-gateway.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/warp-egress-gateway/firewall-apply.sh
ExecReload=/usr/local/lib/warp-egress-gateway/firewall-apply.sh
# Deliberately do not remove the firewall on stop. This prevents direct-uplink
# leakage when the tunnel or routing service is stopped or fails.
ExecStop=/bin/true

[Install]
WantedBy=sysinit.target
