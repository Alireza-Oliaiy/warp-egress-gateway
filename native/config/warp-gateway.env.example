# WARP Egress Gateway configuration
# Copy to /etc/warp-egress-gateway/warp-gateway.env before installation.

# Interface receiving routed/NATed traffic from the upstream firewall/router.
TRANSIT_IF="ens35"

# Optional address configured by this project on TRANSIT_IF.
# Leave MANAGE_TRANSIT_ADDRESS=false when the address is managed elsewhere.
MANAGE_TRANSIT_ADDRESS="false"
TRANSIT_CIDR="198.51.100.2/30"

# Only this source may use the gateway. A CIDR is accepted.
# When FortiGate SNAT is enabled, use the FortiGate /30 address as /32.
TRUSTED_SOURCE_CIDR="198.51.100.1/32"

# Normal management/uplink interface. The host default route must remain here.
UPLINK_IF="ens33"
UPLINK_GATEWAY="203.0.113.1"

# WARP WireGuard interface settings.
WARP_IF="warp0"
WARP_MTU="1280"
PERSISTENT_KEEPALIVE="25"
TCP_MSS="1240"

# Policy-routing settings. Choose values unused by the host.
ROUTING_TABLE_ID="100"
ROUTING_TABLE_NAME="warp_gateway"
SOURCE_RULE_PRIORITY="100"
INGRESS_RULE_PRIORITY="110"

# Unofficial wgcf helper used to register a consumer WARP profile.
WGCF_VERSION="2.2.31"

# Set to yes only after reviewing Cloudflare terms. Required for unattended registration.
ACCEPT_CLOUDFLARE_TOS="no"

# Existing profile option. Leave empty to register a new account.
# The file must use WireGuard format and contain one IPv4 Address.
EXISTING_WARP_PROFILE=""

# Health monitoring.
HEALTHCHECK_URL="https://www.cloudflare.com/cdn-cgi/trace"
HEALTHCHECK_INTERVAL="60"
HEALTHCHECK_TIMEOUT="15"
AUTO_RECOVER="false"

# Passive observability. A structured STATUS line is recorded every minute.
MONITOR_INTERVAL="60"
MONITOR_HANDSHAKE_WARN_SEC="120"
MONITOR_CURL_TIMEOUT="10"
# Upstream peer monitoring: auto derives a /32 peer, off disables ping, or set an exact IPv4.
UPSTREAM_MONITOR_IP="auto"

# Keep IPv6 disabled for transit traffic unless the complete IPv6 path is designed.
ENABLE_IPV6_TRANSIT="false"
