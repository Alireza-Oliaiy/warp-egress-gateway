[Unit]
Description=Fail-closed host guard for Docker WARP Egress Gateway
DefaultDependencies=no
Requires=systemd-sysctl.service
After=local-fs.target systemd-sysctl.service
Wants=network-pre.target
Before=network-pre.target docker.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/warp-egress-docker-guard-apply
ExecReload=/usr/local/sbin/warp-egress-docker-guard-apply
ExecStop=/bin/true

[Install]
WantedBy=sysinit.target
