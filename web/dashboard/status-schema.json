{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/warp-egress-dashboard/status-v1.schema.json",
  "title": "WARP Egress Dashboard Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "overall", "system", "warp", "paths", "routing", "safety", "monitoring"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "overall": {"$ref": "#/$defs/overall"},
    "system": {"$ref": "#/$defs/system"},
    "warp": {"$ref": "#/$defs/warp"},
    "paths": {"$ref": "#/$defs/paths"},
    "routing": {"$ref": "#/$defs/routing"},
    "safety": {"$ref": "#/$defs/safety"},
    "monitoring": {"$ref": "#/$defs/monitoring"}
  },
  "$defs": {
    "overall": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["online", "degraded", "offline", "unknown"]}}},
    "system": {"type": "object", "additionalProperties": false, "required": ["hostname", "version", "uptime_seconds"], "properties": {"hostname": {"type": "string", "minLength": 1, "maxLength": 253}, "version": {"type": "string"}, "uptime_seconds": {"type": ["integer", "null"], "minimum": 0}}},
    "warp": {"type": "object", "additionalProperties": false, "required": ["state", "interface", "handshake_age_seconds", "public_ip", "colo", "location"], "properties": {"state": {"enum": ["connected", "disconnected", "unknown"]}, "interface": {"enum": ["up", "down", "unknown"]}, "handshake_age_seconds": {"type": ["integer", "null"], "minimum": 0}, "public_ip": {"type": ["string", "null"]}, "colo": {"type": ["string", "null"]}, "location": {"type": ["string", "null"]}}},
    "path": {"type": "object", "additionalProperties": false, "required": ["state", "warp"], "properties": {"state": {"enum": ["ok", "failed", "unknown"]}, "warp": {"enum": ["on", "off", "unknown"]}}},
    "paths": {"type": "object", "additionalProperties": false, "required": ["direct", "warp"], "properties": {"direct": {"$ref": "#/$defs/path"}, "warp": {"$ref": "#/$defs/path"}}},
    "routing": {"type": "object", "additionalProperties": false, "required": ["rule_100", "rule_110", "table_100", "main_default"], "properties": {"rule_100": {"enum": ["ok", "failed", "unknown"]}, "rule_110": {"enum": ["ok", "failed", "unknown"]}, "table_100": {"enum": ["ok", "failed", "unknown"]}, "main_default": {"enum": ["ok", "failed", "unknown"]}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["kill_switch", "ipv4_forwarding"], "properties": {"kill_switch": {"enum": ["active", "inactive", "unknown"]}, "ipv4_forwarding": {"type": ["boolean", "null"]}}},
    "monitoring": {"type": "object", "additionalProperties": false, "required": ["health", "monitor", "health_timer", "monitor_timer", "failed_units"], "properties": {"health": {"enum": ["ok", "warn", "failed", "unknown"]}, "monitor": {"enum": ["ok", "warn", "failed", "unknown"]}, "health_timer": {"enum": ["active", "inactive", "unknown"]}, "monitor_timer": {"enum": ["active", "inactive", "unknown"]}, "failed_units": {"type": ["integer", "null"], "minimum": 0}}}
  }
}
